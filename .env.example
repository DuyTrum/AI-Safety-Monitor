# ==============================================================================
# AI Safety Monitor - Cấu hình Biến Môi Trường (Environment Variables)
# ==============================================================================
# Sao chép tệp này thành .env khi cần tùy chỉnh:
# cp .env.example .env

# Đường dẫn trọng số mô hình YOLO (mặc định: weights/best.pt)
MODEL_PATH=weights/best.pt

# Chuỗi kết nối Cơ sở dữ liệu PostgreSQL (Tùy chọn. Nếu không có, hệ thống tự fallback In-Memory)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/safety_monitor

# Cấu hình Cổng chạy
PORT=8000
HOST=0.0.0.0

# Frontend API URL (Nếu chạy Frontend trên máy khác hoặc Production)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
