.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#1255, lock files should be placed under version control
#   unless they are used for platform-specific builds.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock should be tracked under version control.
# poetry.lock

